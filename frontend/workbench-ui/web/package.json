  "engines": {
    "node": ">=18"
  },
  "workspaces": [
  "micro-ui-internals/packages/libraries",
  "micro-ui-internals/packages/react-components",
  "micro-ui-internals/packages/modules/core",
  "micro-ui-internals/packages/modules/workbench",
  "micro-ui-internals/packages/modules/hrms",
  "micro-ui-internals/packages/modules/pgr",
  "micro-ui-internals/packages/modules/utilities",
  "micro-ui-internals/packages/modules/engagement",
  "micro-ui-internals/packages/modules/common",
  "micro-ui-internals/packages/modules/dss"
  ],
  "homepage": "/workbench-ui",
  "dependencies": {
    "@djb25/digit-ui-css": "1.0.77",
    "@egovernments/digit-ui-libraries": "1.8.1",
    "@nudmcdgnpm/digit-ui-module-workbench": "1.0.0",
    "@egovernments/digit-ui-module-core": "1.8.2",
    "@egovernments/digit-ui-react-components": "1.8.4",
    "@egovernments/digit-ui-module-utilities": "1.0.0",
    "@egovernments/digit-ui-module-hrms":"1.8.0",
    "@egovernments/digit-ui-module-pgr":"1.8.0",
    "@egovernments/digit-ui-module-engagement":"1.5.20",
    "babel-loader": "9.1.2",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "clean-webpack-plugin": "4.0.0",
    "react-router-dom": "5.3.0",
    "react-scripts": "5.0.1",
    "react-tooltip": "4.2.21",
    "terser-brunch": "4.1.0",
    "webpack-cli": "4.10.0",
    "web-vitals": "1.1.2",
    "react-hook-form": "6.15.8",
    "react-i18next": "11.16.2",
    "react-query": "3.6.1",
    "keycloak-js": "26.0.7",
    "html-webpack-plugin": "5.5.0"
  },
  "devDependencies": {
    "http-proxy-middleware": "1.3.1",
    "lodash": "4.17.21",
    "microbundle-crl": "0.13.11",
    "husky": "7.0.4",
    "lint-staged": "12.3.7",
    "npm-run-all": "4.1.5",
    "prettier": "2.1.2"
  },
  "resolutions":  {
    "**/babel-loader": "9.1.2",
    "**/@babel/core": "7.14.0",
    "**/@babel/preset-env": "7.14.0",
    "**/@babel/plugin-transform-modules-commonjs": "7.14.0",
    "**/polished":"4.2.2",
    "fast-uri":"2.1.0",
    "**/@babel/runtime": "7.20.1",
    "**/babel-preset-react-app": "10.0.0",
    "**/styled-components": "5.0.0",
    "lru-cache": "^6.0.0",
    "**/lru-cache": "^6.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "GENERATE_SOURCEMAP=false SKIP_PREFLIGHT_CHECK=true react-scripts build",
    "build:prepare": "./build.sh",
    "build:libraries": "cd micro-ui-internals && yarn build",
    "build:prod": "webpack --mode production",
    "build:webpack":"yarn build:libraries &&cd .. && ls && cd ./web && ls && yarn build:prod",
    "clean": "rm -rf node_modules",
    "postinstall": "node -e \"const fs = require('fs'), p = './node_modules/react-scripts/config/webpack.config.js'; if (fs.existsSync(p)) { let c = fs.readFileSync(p, 'utf8'); if (!c.includes('fullySpecified')) { fs.writeFileSync(p, c.replace('rules: [', 'rules: [ { test: /\\\\\\\\.m?js$/, resolve: { fullySpecified: false } },'), 'utf8'); console.log('Patched webpack.config.js'); } }\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
